from pydantic_settings import BaseSettings

class Settings(BaseSettings):
    PROJECT_NAME: str = "{{ project_name }}"
    DEBUG: bool = True
    DATABASE_URL: str = "{% if database == 'SQLite' %}sqlite+aiosqlite:///./test.db{% else %}postgresql+asyncpg://postgres:postgres@localhost:5432/postgres{% endif %}"

    {% if auth_jwt %}
    SECRET_KEY: str = "super-secret-key-change-me-in-production"
    ALGORITHM: str = "HS256"
    ACCESS_TOKEN_EXPIRE_MINUTES: int = 30
    {% endif %}

    class Config:
        case_sensitive = True

settings = Settings()
